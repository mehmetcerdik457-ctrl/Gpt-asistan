{
  "version": 1,
  "principle": "least-privilege",
  "require_policy_check": true,
  "require_evidence_after_action": true,
  "deny": [
    "production-deploy",
    "production-secret-read",
    "credential-export"
  ],
  "allow_platform": [
    "repository-read",
    "branch-create",
    "pull-request-create",
    "ci-observe",
    "evidence-readback"
  ]
}
