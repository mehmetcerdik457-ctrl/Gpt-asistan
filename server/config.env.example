# Run behind a trusted HTTPS reverse proxy; never expose the HTTP port publicly.
# Install: python -m pip install -r server/requirements.txt
# Run: python -m server.gateway
# Provision these public identities only after verifying Mehmet's registration.
OMEGA_OWNER_ID=
OMEGA_DEVICE_ID=
OMEGA_OWNER_PUBLIC_DER_B64=
OMEGA_DEVICE_PUBLIC_DER_B64=
# Persistent, private storage. Parent directory must exist, e.g. a mounted volume.
OMEGA_NONCE_DB=/data/kral-nonces.sqlite3
OMEGA_DATA_DB=/data/kral.sqlite3
# Server vault only. Models are not shown until a real completion is verified.
OPENAI_API_KEY=
# Managed cloud proxy binding alias when OPENAI_ secret names are reserved.
# Existing OPENAI_API_KEY takes precedence. Never put either value in the APK.
KRAL_OPENAI_API_KEY=
# Requested Sol model is only attempted when the owner has real API access.
OPENAI_ALLOWED_MODELS=gpt-5.6-sol
OPENAI_MODEL_PREFERRED=gpt-5.6-sol
# Default loopback; a private container network may require 0.0.0.0 behind TLS.
KRAL_BIND=127.0.0.1
PORT=8080
