# Run behind a trusted HTTPS reverse proxy; never expose the HTTP port publicly.
# Install: python -m pip install -r server/requirements.txt -r server/requirements-postgres.txt
# Run: python -m server.gateway
# Provision these public identities only after verifying Mehmet's registration.
OMEGA_OWNER_ID=
OMEGA_DEVICE_ID=
OMEGA_OWNER_PUBLIC_DER_B64=
OMEGA_DEVICE_PUBLIC_DER_B64=
# Persistent, private storage. Parent directory must exist, e.g. a mounted volume.
OMEGA_NONCE_DB=/data/kral-nonces.sqlite3
OMEGA_DATA_DB=/data/kral.sqlite3
# Server vault only. Models are not shown until a real completion is verified.
OPENAI_API_KEY=
# Requested Sol model is only attempted when the owner has real API access.
OPENAI_ALLOWED_MODELS=gpt-5.6-sol
OPENAI_MODEL_PREFERRED=gpt-5.6-sol
# Default loopback; a private container network may require 0.0.0.0 behind TLS.
KRAL_BIND=127.0.0.1
PORT=8080
# E-mail OTP login. Set your verified owner address in a private server environment.
# If unset or malformed, OTP requests fail closed (503). Never commit an owner mailbox.
KRAL_OTP_OWNER_EMAIL=
# Stable random secret, at least 32 bytes; share between gateway workers.
# Missing/short secrets disable real SMTP OTP requests (503).
KRAL_OTP_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Set SMTP_SSL=true for implicit TLS (usually port 465); otherwise STARTTLS is used.
SMTP_SSL=

# Explicit ORBA runtime. NO is the default; flags alone do not provision it.
# Never commit populated secrets/ADC. See docs/ORBA_RUNTIME_CONFIGURATION.md.
ORBA_PLAY_BOUNDARY_ENABLED=NO
ORBA_PLAY_RTDN_ENABLED=NO
ORBA_PLAY_OAUTH_ENABLED=NO
ORBA_PLAY_PACKAGE=com.example.gptasistan.genesis
ORBA_PLAY_PRODUCTS=
ORBA_PLAY_DATABASE_DSN=
ORBA_PLAY_DATABASE_SCHEMA=orba
ORBA_PLAY_PUBLISHER_SERVICE_ACCOUNT=
ORBA_PLAY_SERVER_SECRET_B64=
ORBA_PLAY_PUBSUB_AUDIENCE=
ORBA_PLAY_PUBSUB_SERVICE_ACCOUNT=
ORBA_PLAY_PUBSUB_SUBSCRIPTION=
