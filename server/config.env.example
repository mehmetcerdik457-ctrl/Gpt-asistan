# Run behind a trusted HTTPS reverse proxy; never expose the HTTP port publicly.
# Install: python -m pip install -r server/requirements.txt
# Run: python -m server.gateway
# Provision these public identities only after verifying Mehmet's registration.
OMEGA_OWNER_ID=
OMEGA_DEVICE_ID=
OMEGA_OWNER_PUBLIC_DER_B64=
OMEGA_DEVICE_PUBLIC_DER_B64=
# Persistent, private storage. Parent directory must exist, e.g. a mounted volume.
OMEGA_NONCE_DB=/data/kral-nonces.sqlite3
OMEGA_DATA_DB=/data/kral.sqlite3
# Server vault only. Models are not shown until a real completion is verified.
OPENAI_API_KEY=
OPENAI_ALLOWED_MODELS=
# Explicit provider routing (default: openai). The optional independent
# endpoint below is NOT recovered from the proprietary CİHAT APK.
# Only configure with an API endpoint and permission you actually own.
KRAL_PROVIDER_MODE=openai
# Issue advisory is separately opt-in. Labeling an issue alone never approves cost.
KRAL_ADVISORY_COST_APPROVED=NO
KRAL_OWNER_GATEWAY_URL=
KRAL_OWNER_GATEWAY_HOST=
KRAL_OWNER_GATEWAY_TOKEN=
KRAL_OWNER_GATEWAY_MODEL=
# Optional Workers AI (a catalog does not prove model access).
KRAL_CLOUDFLARE_ACCOUNT_ID=
KRAL_CLOUDFLARE_MODEL=
KRAL_CLOUDFLARE_API_TOKEN=
# Separate owner cost approval; only YES enables billable Cloudflare requests.
KRAL_CLOUDFLARE_COST_APPROVED=NO
# Optional: two+ independently checked providers. All flags must be set
# deliberately after owner authorization and accepted upstream costs.
# NEVER set these on behalf of the owner or for a CI/mock test deployment.
# KRAL_PROVIDER_MODE=multi_verified
KRAL_MULTI_ROUTER_APPROVED=NO
KRAL_MULTI_COST_APPROVED=NO
KRAL_MULTI_PROVIDERS=
# Default loopback; a private container network may require 0.0.0.0 behind TLS.
KRAL_BIND=127.0.0.1
PORT=8080
